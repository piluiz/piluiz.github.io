---
// The ASCII banner the LVS check prints when the layout matches the schematic.
// The smiley blinks now and then.
---

<section class="box lvs">
  <div class="label">[ <b>lvs.report</b> ]</div>
  <pre aria-label="LVS report banner: CORRECT, with a smiley face"><span class="mu">LVS: layout vs. schematic</span>

<span class="ok">                #     ###################       _   _
               #      #                 #       <span class="eye">*   *</span>
          #   #       #     CORRECT     #         |
           # #        #                 #       \___/
            #         ###################</span></pre>
  <p class="note">What every cell and the full datapath eventually had to print.</p>
</section>

<style>
  .lvs { margin: 28px 0; }
  .lvs pre { margin: 0 0 12px; font: 13px/1.3 var(--mono); overflow-x: auto; color: var(--muted); border: 0; padding: 0; background: none; }
  .lvs .mu { color: var(--muted); }
  .lvs .ok { color: var(--accent); font-weight: 600; }
  .lvs .note { font: 12px/1.6 var(--mono); color: var(--muted); margin: 0 0 6px; }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".lvs .eye").forEach((eye) => {
    setInterval(() => {
      if (document.hidden) return;
      eye.textContent = "-   -";
      setTimeout(() => (eye.textContent = "*   *"), 180);
    }, 3200);
  });
</script>
